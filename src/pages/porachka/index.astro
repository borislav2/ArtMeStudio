---
import Base from "../../layouts/Base.astro";
---
<Base title="Поръчка" noindex>
  <div class="page-head"><div class="wrap"><nav class="crumbs" aria-label="Път"><a href="/kolichka">Количка</a><span>/</span><span>Поръчка</span></nav><h1>Данни за поръчката</h1></div></div>
  <div class="wrap cart-grid">
    <form id="co" novalidate style="grid-template-columns:1fr 1fr">
      <div class="f half"><label for="cName">Име и фамилия</label><input id="cName" name="name" autocomplete="name" required maxlength="80"></div>
      <div class="f half"><label for="cPhone">Телефон</label><input id="cPhone" name="phone" type="tel" autocomplete="tel" required maxlength="30"></div>
      <div class="f"><label for="cEmail">Имейл</label><input id="cEmail" name="email" type="email" autocomplete="email" required maxlength="120"></div>
      <fieldset class="f">
        <legend class="opt-label">Доставка с Еконт</legend>
        <div class="radio-cards">
          <label><input type="radio" name="delivery" value="office" checked><span>До офис на Еконт</span></label>
          <label><input type="radio" name="delivery" value="address"><span>До адрес</span></label>
          <label><input type="radio" name="delivery" value="pickup"><span>Вземам от студиото в Левски</span></label>
        </div>
      </fieldset>
      <div class="f half" data-need="office address"><label for="cCity">Град</label><input id="cCity" name="city" autocomplete="address-level2" maxlength="60"></div>
      <div class="f half" data-need="office address"><label for="cAddr" id="cAddrL">Офис на Еконт</label><input id="cAddr" name="address" maxlength="160" placeholder="напр. Плевен, офис Център"></div>
      <fieldset class="f">
        <legend class="opt-label">Капаро 50%</legend>
        <div class="pay-opts radio-cards" id="payOpts">
          <label><input type="radio" name="payment" value="bank" checked><span>Банков превод (получаваш данни по имейл)</span></label>
          <label data-card hidden><input type="radio" name="payment" value="card"><span>С карта онлайн</span></label>
        </div>
      </fieldset>
      <div class="f"><label for="cNote">Бележка</label><textarea id="cNote" name="note" maxlength="2000" placeholder="Спонсори, специфични цветове, удобно време за обаждане…"></textarea></div>
      <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
      <label class="consent" for="cOk"><input id="cOk" name="consent" type="checkbox" required> <span>Съгласен съм с <a href="/obshti-usloviya">общите условия</a>, включително че капарото не се връща след започване на работа.</span></label>
      <p class="f err" id="cErr" role="alert"></p>
      <button class="btn btn-plate" type="submit">Потвърди поръчката</button>
    </form>
    <aside class="summary" aria-label="Обобщение">
      <div id="coLines"></div>
      <div class="row total"><span>Общо</span><span id="cTot"></span></div>
      <div class="row adv"><span>Капаро сега (50%)</span><span id="cAdv"></span></div>
      <p class="note">След поръчката ще ти изпратим 3D визуализация. Печатаме само след твоето одобрение.</p>
    </aside>
  </div>
</Base>
<script>
  import { readCart, writeCart } from "../../lib/cart";
  import { priceLines, eur } from "../../lib/pricing";
  const raw = readCart(); const { lines, subtotal, advance } = priceLines(raw);
  if (!lines.length) location.replace("/kolichka");
  document.getElementById("coLines")!.innerHTML = lines.map(l => `<div class="row"><span>${l.qty} × ${l.title.replace(/</g, "&lt;")}</span><span>${eur(l.total)}</span></div>`).join("");
  document.getElementById("cTot")!.textContent = eur(subtotal);
  document.getElementById("cAdv")!.textContent = eur(advance);
  if (import.meta.env.PUBLIC_STATIC !== "true") fetch("/api/order").then(r => r.json()).then(j => { if (j.card) document.querySelector<HTMLElement>("[data-card]")!.hidden = false; }).catch(() => {});

  const f = document.getElementById("co") as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const syncDelivery = () => {
    const d = (f.elements.namedItem("delivery") as RadioNodeList).value;
    f.querySelectorAll<HTMLElement>("[data-need]").forEach(el => (el.hidden = !el.dataset.need!.split(" ").includes(d)));
    $("cAddrL").textContent = d === "address" ? "Адрес" : "Офис на Еконт";
  };
  f.addEventListener("change", syncDelivery); syncDelivery();
  f.addEventListener("submit", async e => {
    e.preventDefault(); const err = $("cErr"); err.textContent = "";
    const fd = Object.fromEntries(new FormData(f)) as Record<string, string>;
    const fail = (m: string, id: string) => { err.textContent = m; $(id).focus(); };
    if (!fd.name?.trim()) return fail("Въведи име и фамилия.", "cName");
    if ((fd.phone || "").replace(/\D/g, "").length < 6) return fail("Въведи телефон за връзка.", "cPhone");
    if (!/^\S+@\S+\.\S+$/.test(fd.email || "")) return fail("Въведи имейл. На него изпращаме 3D визуализацията.", "cEmail");
    if (fd.delivery !== "pickup" && (!fd.city?.trim() || !fd.address?.trim())) return fail("Попълни град и офис или адрес за доставка.", fd.city ? "cAddr" : "cCity");
    if (!$("cOk").checked) return fail("Потвърди общите условия, за да завършиш поръчката.", "cOk");
    const btn = f.querySelector("button[type=submit]") as HTMLButtonElement; btn.disabled = true; btn.textContent = "Изпращане…";
    try {
      let j: { orderNo?: string; payUrl?: string; error?: string } = { orderNo: "DEMO-" + Math.random().toString(36).slice(2, 6).toUpperCase() };
      if (import.meta.env.PUBLIC_STATIC !== "true") { // static demo has no server: simulate the order
        const res = await fetch("/api/order", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...fd, consent: true, items: raw }) });
        j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || "Поръчката не беше изпратена.");
      }
      writeCart([]);
      location.href = j.payUrl || `/porachka/uspeh?no=${encodeURIComponent(j.orderNo || "")}&pay=${fd.payment}`;
    } catch (x: any) {
      err.textContent = `${x.message} Опитай отново или се обади на 0886 216 097.`;
      btn.disabled = false; btn.textContent = "Потвърди поръчката";
    }
  });
</script>
